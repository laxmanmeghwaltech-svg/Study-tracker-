        </div>
      </div>
      <div class="flex-between">
        <input type="number" id="log-hours" step="0.5" min="0.5" max="18" value="1.5" placeholder="Hours (e.g. 1.5)" style="flex:1;">
        <button class="btn-primary" onclick="saveStudyLog()">+ Add Hours</button>
      </div>
      <div class="flex-wrap" style="margin-top:8px;">
        <span class="text-muted" style="font-size:0.78rem;">Quick add today:</span>
        <button class="btn-sm" onclick="quickHours(0.5)">+0.5h</button>
        <button class="btn-sm" onclick="quickHours(1)">+1h</button>
        <button class="btn-sm" onclick="quickHours(2)">+2h</button>
      </div>
    </div>

    <div class="card">
      <div class="flex-between" style="margin-bottom:8px;">
        <div style="font-weight:700;">Last 7 Days (Hours)</div>
        <div class="text-muted">${days.reduce((a,b)=>a+b.total,0).toFixed(1)}h total</div>
      </div>
      <svg viewBox="0 0 ${svgW} ${svgH}" style="width:100%;height:auto;background:var(--bg);border-radius:8px;padding:6px;">
        <line x1="10" y1="${padT + chartH}" x2="${svgW - 10}" y2="${padT + chartH}" stroke="var(--border)" stroke-width="1"/>
