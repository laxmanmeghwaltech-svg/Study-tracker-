function renderLog(app) {
  document.getElementById('header-title').textContent = 'Study Log';
  const enabledSubs = state.subjects.filter(s => s.enabled);
  const t0 = todayStr(0);

  // Build 7-day data
  const days = [];
  let maxDayTotal = 4;
  for (let i = 6; i >= 0; i--) {
    const dStr = todayStr(i);
    const dayObj = state.studyLog[dStr] || {};
    let total = 0;
    const segments = [];
    state.subjects.forEach(s => {
      const h = Number(dayObj[s.id] || 0);
      if (h > 0) {
        total += h;
        segments.push({ color: s.color, hours: h, name: s.name });
      }
    });
    if (total > maxDayTotal) maxDayTotal = Math.ceil(total);
    const label = new Date(dStr + 'T00:00:00').toLocaleDateString('en-IN', { weekday: 'short' });
    days.push({ dStr, label, total: Math.round(total * 10) / 10, segments });
  }

  // Render SVG Stacked Bar Chart
  const svgW = 350, svgH = 170, padB = 28, padT = 22, chartH = svgH - padB - padT;
  const barW = 28, gap = (svgW - (barW * 7)) / 8;

  const barsSvg = days.map((d, idx) => {
    const x = gap + idx * (barW + gap);
    let curY = padT + chartH;
    const rects = d.segments.map(seg => {
      const h = (seg.hours / maxDayTotal) * chartH;
      curY -= h;
      return `<rect x="${x}" y="${curY}" width="${barW}" height="${h}" rx="3" fill="${seg.color}"/>`;
    }).join('');
    return `
      ${rects}
      <text x="${x + barW/2}" y="${curY - 5}" text-anchor="middle" font-size="10" font-weight="700" fill="var(--text)">${d.total > 0 ? d.total + 'h' : ''}</text>
      <text x="${x + barW/2}" y="${svgH - 8}" text-anchor="middle" font-size="11" fill="var(--text-muted)">${d.label}</text>
    `;
  }).join('');

  app.innerHTML = `
    <div class="card">
      <div style="font-weight:700;margin-bottom:10px;">Log Study Hours</div>
      <div class="grid-2" style="margin-bottom:10px;">
        <div>
