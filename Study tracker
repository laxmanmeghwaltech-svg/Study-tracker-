============================================================================ */
function getChapterStats(ch) {
  const total = ch.topics.length;
  const done = ch.topics.filter(t => t.done).length;
  const pct = total === 0 ? 0 : Math.round((done / total) * 100);
  return { total, done, rem: total - done, pct };
}

function getSubjectStats(sub) {
  let total = 0, done = 0;
  sub.chapters.forEach(ch => {
    total += ch.topics.length;
    done += ch.topics.filter(t => t.done).length;
  });
  const pct = total === 0 ? 0 : Math.round((done / total) * 100);
  return { total, done, rem: total - done, pct };
}

function getOverallStats() {
  let total = 0, done = 0;
  state.subjects.filter(s => s.enabled).forEach(sub => {
    const st = getSubjectStats(sub);
    total += st.total;
    done += st.done;
  });
  const pct = total === 0 ? 0 : Math.round((done / total) * 100);
  return { total, done, rem: total - done, pct };
}

function isActiveDay(dateStr) {
  const log = state.studyLog[dateStr];
  if (log && Object.values(log).some(v => Number(v) > 0)) return true;
  for (const s of state.subjects) {
    if (!s.enabled) continue;
    for (const c of s.chapters) {
      for (const t of c.topics) {
        if (t.done && t.doneAt === dateStr) return true;
      }
    }
  }
  return false;
}

function getStreak() {
  let streak = 0;
  const t0 = todayStr(0);
  let startOffset = isActiveDay(t0) ? 0 : 1;
  for (let i = startOffset; i < 365; i++) {
    if (isActiveDay(todayStr(i))) streak++;
    else break;
  }
  return { streak, activeToday: isActiveDay(t0) };
}

function getDaysLeft(dateStr) {
  if (!dateStr) return null;
  const target = new Date(dateStr + 'T00:00:00');
  const now = new Date(todayStr(0) + 'T00:00:00');
  const diff = Math.ceil((target - now) / (1000 * 60 * 60 * 24));
  return diff;
}

