/* ============================================================================
   NAVIGATION & RENDERING
============================================================================ */
function navigate(view, subId = null) {
  currentView = view;
  if (subId) activeSubjectId = subId;
  document.querySelectorAll('.nav-item').forEach(el => el.classList.remove('active'));
  const navMap = { home: 'nav-home', subjects: 'nav-subjects', subjectDetail: 'nav-subjects', log: 'nav-log', settings: 'nav-settings' };
  const activeNav = document.getElementById(navMap[view]);
  if (activeNav) activeNav.classList.add('active');
  window.scrollTo(0, 0);
  render();
}

function escapeHtml(str) {
  return String(str).replace(/[&<>"']/g, m => ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[m]));
}

function renderRing(pct, color, size = 54) {
  const stroke = 5;
  const r = (size - stroke) / 2;
  const c = 2 * Math.PI * r;
  const offset = c - (pct / 100) * c;
  return `
    <svg width="${size}" height="${size}" viewBox="0 0 ${size} ${size}">
      <circle cx="${size/2}" cy="${size/2}" r="${r}" fill="none" stroke="var(--border)" stroke-width="${stroke}"/>
      <circle cx="${size/2}" cy="${size/2}" r="${r}" fill="none" stroke="${color}" stroke-width="${stroke}"
        stroke-dasharray="${c}" stroke-dashoffset="${offset}" stroke-linecap="round"
        transform="rotate(-90 ${size/2} ${size/2})"/>
      <text x="50%" y="50%" dominant-baseline="central" text-anchor="middle" font-size="12" font-weight="700" fill="var(--text)">${pct}%</text>
    </svg>
  `;
}

function render() {
  const app = document.getElementById('app');
  if (currentView === 'home') renderHome(app);
  else if (currentView === 'subjects') renderSubjects(app);
  else if (currentView === 'subjectDetail') renderSubjectDetail(app);
  else if (currentView === 'log') renderLog(app);
  else if (currentView === 'settings') renderSettings(app);
}

