      <div class="text-muted" style="margin-bottom:10px;">Reset all progress, logs, and custom edits back to factory Class 12 defaults.</div>
      <button class="btn-danger" onclick="resetAll()">🗑️ Reset All Data</button>
    </div>
  `;
}

/* ============================================================================
   INTERACTIVE ACTIONS (CRUD, LOGGING, IMPORT/EXPORT)
============================================================================ */
function toggleTopic(subId, chId, tpId, expandFalse = false) {
  const sub = state.subjects.find(s => s.id === subId);
  if (!sub) return;
  const ch = sub.chapters.find(c => c.id === chId);
  if (!ch) return;
  const tp = ch.topics.find(t => t.id === tpId);
  if (!tp) return;
  tp.done = !tp.done;
  tp.doneAt = tp.done ? todayStr(0) : null;
  saveState();
  render();
}

function toggleChapterExpand(subId, chId) {
  const sub = state.subjects.find(s => s.id === subId);
  const ch = sub && sub.chapters.find(c => c.id === chId);
  if (ch) { ch.expanded = !ch.expanded; saveState(); render(); }
}

function toggleRevision(subId, chId, rIdx) {
  const sub = state.subjects.find(s => s.id === subId);
  const ch = sub && sub.chapters.find(c => c.id === chId);
  if (!ch) return;
  if (!Array.isArray(ch.rev)) ch.rev = [false, false, false];
  ch.rev[rIdx] = !ch.rev[rIdx];
  saveState();
  render();
}

function toggleSubject(subId) {
  const sub = state.subjects.find(s => s.id === subId);
  if (sub) { sub.enabled = !sub.enabled; saveState(); render(); }
}

function setTargetDate(subId, val) {
  const sub = state.subjects.find(s => s.id === subId);
  if (sub) { sub.targetDate = val; saveState(); render(); }
}

function addSubject() {
  const name = prompt("Enter new Subject Name (e.g., Computer Science, Physical Education):");
  if (!name || !name.trim()) return;
  const colors = ['#06b6d4', '#f97316', '#84cc16', '#a855f7', '#ec4899', '#14b8a6'];
  const color = colors[state.subjects.length % colors.length];
  state.subjects.push({
    id: 'sub_' + Date.now(),
    name: name.trim(),
    color,
    enabled: true,
    targetDate: '',
    chapters: makeChapters(["Chapter 1: Introduction"], STD_TOPICS)
  });
  saveState();
  render();
}

function renameSubject(subId) {
  const sub = state.subjects.find(s => s.id === subId);
  if (!sub) return;
  const name = prompt("Rename Subject:", sub.name);
  if (name && name.trim()) { sub.name = name.trim(); saveState(); render(); }
}

function deleteSubject(subId) {
  const sub = state.subjects.find(s => s.id === subId);
  if (!sub) return;
  if (!confirm(`Delete subject "${sub.name}" and all its chapters?`)) return;
  state.subjects = state.subjects.filter(s => s.id !== subId);
  saveState();
  render();
}

function addChapter(subId) {
  const sub = state.subjects.find(s => s.id === subId);
  if (!sub) return;
  const title = prompt("Enter Chapter Name:");
  if (!title || !title.trim()) return;
  const isLit = sub.id === 'sub_eng' || sub.id === 'sub_hin';
  const ch = makeChapters([title.trim()], isLit ? LIT_TOPICS : STD_TOPICS)[0];
  ch.expanded = true;
  sub.chapters.push(ch);
  saveState();
  render();
}

function renameChapter(subId, chId) {
  const sub = state.subjects.find(s => s.id === subId);
  const ch = sub && sub.chapters.find(c => c.id === chId);
  if (!ch) return;
  const title = prompt("Rename Chapter:", ch.title);
  if (title && title.trim()) { ch.title = title.trim(); saveState(); render(); }
}

function deleteChapter(subId, chId) {
  const sub = state.subjects.find(s => s.id === subId);
  if (!sub) return;
  if (!confirm("Delete this chapter?")) return;
  sub.chapters = sub.chapters.filter(c => c.id !== chId);
  saveState();
  render();
}

function moveChapter(subId, idx, dir) {
  const sub = state.subjects.find(s => s.id === subId);
  if (!sub) return;
  const target = idx + dir;
  if (target < 0 || target >= sub.chapters.length) return;
  const temp = sub.chapters[idx];
  sub.chapters[idx] = sub.chapters[target];
  sub.chapters[target] = temp;
  saveState();
  render();
}
function addTopic(subId, chId) {
  const sub = state.subjects.find(s => s.id === subId);
  const ch = sub && sub.chapters.find(c => c.id === chId);
  if (!ch) return;
  const title = prompt("Enter Checklist Topic Name:");
  if (!title || !title.trim()) return;
  ch.topics.push({ id: 'tp_' + Date.now(), title: title.trim(), done: false, doneAt: null });
  saveState();
  render();
}

function renameTopic(subId, chId, tpId) {
  const sub = state.subjects.find(s => s.id === subId);
  const ch = sub && sub.chapters.find(c => c.id === chId);
  const tp = ch && ch.topics.find(t => t.id === tpId);
  if (!tp) return;
  const title = prompt("Rename Topic:", tp.title);
  if (title && title.trim()) { tp.title = title.trim(); saveState(); render(); }
}

function deleteTopic(subId, chId, tpId) {
  const sub = state.subjects.find(s => s.id === subId);
  const ch = sub && sub.chapters.find(c => c.id === chId);
  if (!ch) return;
  ch.topics = ch.topics.filter(t => t.id !== tpId);
  saveState();
  render();
}

function moveTopic(subId, chId, idx, dir) {
  const sub = state.subjects.find(s => s.id === subId);
  const ch = sub && sub.chapters.find(c => c.id === chId);
  if (!ch) return;
  const target = idx + dir;
  if (target < 0 || target >= ch.topics.length) return;
  const temp = ch.topics[idx];
  ch.topics[idx] = ch.topics[target];
  ch.topics[target] = temp;
  saveState();
  render();
}

function switchHindiPreset(subId) {
  const sub = state.subjects.find(s => s.id === subId) || state.subjects.find(s => s.id === 'sub_hin');
  if (!sub) return alert("Hindi subject not found!");
  const isCurrentlyElective = sub.chapters.some(c => c.title.includes("अंतरा"));
  const nextMode = isCurrentlyElective ? "Hindi Core (आरोह भाग 2 + वितान भाग 2)" : "Hindi Elective (अंतरा भाग 2 + अंतराल भाग 2)";
  if (!confirm(`Switch Hindi chapters to ${nextMode}? This will replace current Hindi chapters.`)) return;
  sub.chapters = JSON.parse(JSON.stringify(isCurrentlyElective ? HINDI_CORE_CHAPTERS : HINDI_ELECTIVE_CHAPTERS));
  saveState();
  render();
}

function openQuickLog() {
  navigate('log');
}

function saveStudyLog() {
  const dateEl = document.getElementById('log-date');
  const subEl = document.getElementById('log-sub');
  const hrsEl = document.getElementById('log-hours');
  if (!dateEl || !subEl || !hrsEl) return;
  const d = dateEl.value || todayStr(0);
  const sId = subEl.value;
  const h = parseFloat(hrsEl.value);
  if (isNaN(h) || h <= 0) return alert("Enter valid study hours.");
  if (!state.studyLog[d]) state.studyLog[d] = {};
  state.studyLog[d][sId] = Math.round(((state.studyLog[d][sId] || 0) + h) * 10) / 10;
  saveState();
  render();
}

function quickHours(h) {
  const subEl = document.getElementById('log-sub');
  const sId = subEl ? subEl.value : (state.subjects.find(s => s.enabled) || state.subjects[0]).id;
  const d = todayStr(0);
  if (!state.studyLog[d]) state.studyLog[d] = {};
  state.studyLog[d][sId] = Math.round(((state.studyLog[d][sId] || 0) + h) * 10) / 10;
  saveState();
  render();
}

function clearSubjectLog(d, sId) {
  if (state.studyLog[d]) {
    delete state.studyLog[d][sId];
    saveState();
    render();
  }
}

function exportData() {
  state.lastBackup = Date.now();
  saveState();
  const dataStr = JSON.stringify(state, null, 2);
  const blob = new Blob([dataStr], { type: 'application/json' });
  const url = URL.createObjectURL(blob);
  const a = document.createElement('a');
  a.href = url;
  a.download = `CBSE12_Study_Backup_${todayStr(0)}.json`;
  document.body.appendChild(a);
  a.click();
  a.remove();
  URL.revokeObjectURL(url);
  render();
}

function importData(ev) {
  const file = ev.target.files && ev.target.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = function(e) {
    try {
      const imported = JSON.parse(e.target.result);
      if (!imported || !Array.isArray(imported.subjects)) throw new Error("Invalid format");
      state = imported;
      state.lastBackup = Date.now();
      saveState();
      applyTheme();
      alert("Backup restored successfully!");
      navigate('home');
    } catch (err) {
      alert("Failed to import JSON: Invalid backup file.");
    }
  };
  reader.readAsText(file);
}

function resetAll() {
  if (!confirm("⚠️ Are you sure you want to delete ALL progress and reset to factory Class 12 defaults?")) return;
  state = getDefaultState();
  saveState();
  applyTheme();
  navigate('home');
}

/* ============================================================================
   INLINE PWA MANIFEST & SERVICE WORKER SETUP
   Note: Service workers require HTTPS or localhost to register from a real
   path; Blob-URL service workers are restricted by browser security specs,
   so we attempt inline registration inside a graceful try/catch.
============================================================================ */
(function initPWA() {
  try {
    const iconSvg = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 192 192"><rect width="192" height="192" rx="36" fill="#4f46e5"/><text x="50%" y="55%" dominant-baseline="middle" text-anchor="middle" fill="#fff" font-family="sans-serif" font-weight="800" font-size="84">12</text></svg>`;
    const iconUrl = 'data:image/svg+xml;utf8,' + encodeURIComponent(iconSvg);

    const manifest = {
      name: "Class 12 CBSE Study Tracker",
      short_name: "CBSE 12",
      start_url: ".",
      display: "standalone",
      background_color: "#0f172a",
      theme_color: "#4f46e5",
      icons: [{ src: iconUrl, sizes: "192x192", type: "image/svg+xml" }]
    };
    const mBlob = new Blob([JSON.stringify(manifest)], { type: 'application/manifest+json' });
    const link = document.createElement('link');
    link.rel = 'manifest';
    link.href = URL.createObjectURL(mBlob);
    document.head.appendChild(link);

    if ('serviceWorker' in navigator && (location.protocol === 'https:' || location.hostname === 'localhost')) {
      const swCode = `
        self.addEventListener('install', e => self.skipWaiting());
        self.addEventListener('activate', e => e.waitUntil(self.clients.claim()));
        self.addEventListener('fetch', e => e.respondWith(fetch(e.request).catch(() => caches.match(e.request))));
      `;
      const swBlob = new Blob([swCode], { type: 'application/javascript' });
      navigator.serviceWorker.register(URL.createObjectURL(swBlob)).catch(() => {});
    }
  } catch (e) {}
})();

/* Initialize App */
applyTheme();
checkBackupBanner();
render();
</script>
